# Server Configuration
PORT=8080

# MySQL Configuration (Local or Aiven over TLS)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/melodick_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
HIKARI_MAX_POOL_SIZE=5

# Admin Credentials Bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# JWT Security
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_length_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated or FRONTEND_ORIGIN)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=https://your-project.pages.dev

# Cloudinary Cloud Storage (Free Tier)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Public Platform APIs (YouTube & Spotify)
# Optional: YouTube Data API v3 key (without this, public RSS/oEmbed scraper is used automatically)
YOUTUBE_API_KEY=
# Optional: Spotify Web API credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
STATS_CACHE_TTL_MINUTES=120



